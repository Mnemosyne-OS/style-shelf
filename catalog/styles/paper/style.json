{
  "id": "paper",
  "kind": "style",
  "title": {
    "en": "Paper",
    "fr": "Papier",
    "es": "Papel"
  },
  "license": "MIT",
  "author": "Mnemosyne OS",
  "tier": "free",
  "tags": [
    "light",
    "warm",
    "editorial"
  ],
  "manifest": {
    "id": "paper",
    "name": "Paper",
    "version": "1.0.0",
    "author": "Mnemosyne OS",
    "description": "Warm paper, ink text, terracotta accent, a serif voice.",
    "tokens": {
      "--accent": "#a8411f",
      "--accent-dim": "#86331a",
      "--accent-glow": "rgba(168, 65, 31, 0.16)",
      "--accent-border": "rgba(168, 65, 31, 0.45)",
      "--bg-void": "#f3ece0",
      "--bg-surface": "#ebe2d2",
      "--bg-panel": "#fbf7f0",
      "--bg-card": "#fffdf8",
      "--bg-hover": "#efe6d6",
      "--text-primary": "#2b2420",
      "--text-secondary": "#4f443c",
      "--text-muted": "#655950",
      "--text-accent": "#a8411f",
      "--font-ui": "ui-serif, Georgia, 'Times New Roman', serif",
      "--font-mono": "ui-monospace, 'Cascadia Mono', 'SF Mono', Consolas, monospace",
      "--space-sm": "8px",
      "--space-md": "14px",
      "--space-lg": "22px",
      "--radius-sm": "4px",
      "--radius-md": "8px",
      "--radius-lg": "12px",
      "--border-subtle": "1px solid rgba(43, 36, 32, 0.16)",
      "--border-accent": "1px solid rgba(168, 65, 31, 0.45)",
      "--shadow-card": "2px 3px 0 rgba(43, 36, 32, 0.12), 0 10px 22px -16px rgba(43, 36, 32, 0.45)",
      "--shadow-accent": "0 6px 18px -8px rgba(168, 65, 31, 0.45)",
      "--transition-fast": "120ms ease",
      "--transition-normal": "240ms ease",
      "--status-active": "#2c7146",
      "--status-warning": "#8c5b00",
      "--status-overload": "#b3261e"
    }
  }
}
