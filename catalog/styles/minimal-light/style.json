{
  "id": "minimal-light",
  "kind": "style",
  "title": {
    "en": "Minimal light",
    "fr": "Minimal clair",
    "es": "Minimalista claro"
  },
  "license": "MIT",
  "author": "Mnemosyne OS",
  "tier": "free",
  "tags": [
    "light",
    "minimal"
  ],
  "manifest": {
    "id": "minimal-light",
    "name": "Minimal light",
    "version": "1.0.0",
    "author": "Mnemosyne OS",
    "description": "White ground, near-black text, one blue accent.",
    "tokens": {
      "--accent": "#2a5fe6",
      "--accent-dim": "#1f4bc0",
      "--accent-glow": "rgba(42, 95, 230, 0.14)",
      "--accent-border": "rgba(42, 95, 230, 0.4)",
      "--bg-void": "#ffffff",
      "--bg-surface": "#f6f7f9",
      "--bg-panel": "#ffffff",
      "--bg-card": "#ffffff",
      "--bg-hover": "#f0f2f5",
      "--text-primary": "#111418",
      "--text-secondary": "#3b424c",
      "--text-muted": "#5f6874",
      "--text-accent": "#2a5fe6",
      "--font-ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, 'Helvetica Neue', Arial, sans-serif",
      "--font-mono": "ui-monospace, 'Cascadia Mono', 'SF Mono', Consolas, monospace",
      "--space-sm": "8px",
      "--space-md": "14px",
      "--space-lg": "22px",
      "--radius-sm": "6px",
      "--radius-md": "10px",
      "--radius-lg": "14px",
      "--border-subtle": "1px solid #e3e6eb",
      "--border-accent": "1px solid rgba(42, 95, 230, 0.4)",
      "--shadow-card": "0 1px 2px rgba(17, 20, 24, 0.06), 0 8px 24px -12px rgba(17, 20, 24, 0.18)",
      "--shadow-accent": "0 6px 16px -6px rgba(42, 95, 230, 0.45)",
      "--transition-fast": "120ms ease",
      "--transition-normal": "220ms ease",
      "--status-active": "#1d7a46",
      "--status-warning": "#8a5a00",
      "--status-overload": "#c0262d"
    }
  }
}
